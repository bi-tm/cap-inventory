                            "@Common.DocumentationRef": "urn:sap-com:documentation:key?=type=DE&id=%2FSCWM%2FLGNUM"
                        },
                        "WarehouseOrderCreationRule": {
                            "type": "cds.String",
                            "length": 4,
                            "notNull": true,
                            "@Common.IsUpperCase": true,
                            "@Common.Label": "LA-Erstellungsregel",
                            "@Common.Heading": "Lagerauftragserstellungsregel",
                            "@Common.QuickInfo": "Lagerauftragserstellungsregel",
                            "@Common.DocumentationRef": "urn:sap-com:documentation:key?=type=DE&id=%2FSCWM%2FDE_WCR"
                        },
                        "_WarehouseOrderMergeChild": {
                            "items": {
                                "type": "api_warehouse_order_task_2.D_WhseOrderMergeChildP",
                                "notNull": true
                            }
                        }
                    },
                    "returns": {
                        "items": {
                            "type": "api_warehouse_order_task_2.WarehouseOrder",
                            "notNull": true
                        }
                    }
                },
                "SplitWarehouseOrder": {
                    "kind": "action",
                    "params": {
                        "WarehouseOrderCreationRule": {
                            "type": "cds.String",
                            "length": 4,
                            "notNull": true,
                            "@Common.IsUpperCase": true,
                            "@Common.Label": "LA-Erstellungsregel",
                            "@Common.Heading": "Lagerauftragserstellungsregel",
                            "@Common.QuickInfo": "Lagerauftragserstellungsregel",
                            "@Common.DocumentationRef": "urn:sap-com:documentation:key?=type=DE&id=%2FSCWM%2FDE_WCR"
                        },
                        "_WarehouseOrderSplitChild": {
                            "items": {
                                "type": "api_warehouse_order_task_2.D_WhseOrderSplitChildP",
                                "notNull": true
                            }
                        }
                    },
                    "returns": {
                        "items": {
                            "type": "api_warehouse_order_task_2.WarehouseOrder",
                            "notNull": true
                        }
                    }
                },
                "SetWarehouseOrderToInProcess": {
                    "kind": "action",
                    "params": {}
                },
                "UnlockWarehouseOrder": {
                    "kind": "action",
                    "params": {}
                },
                "UnassignWarehouseOrder": {
                    "kind": "action",
                    "params": {}
                },
                "LockWarehouseOrder": {
                    "kind": "action",
                    "params": {}
                }
            },
            "@Common.Label": "Lagerauftrag",
            "@Common.Messages": {
                "=": "SAP__Messages"
            },
            "@Capabilities.NavigationRestrictions.RestrictedProperties": [
                {
                    "NavigationProperty": {
                        "=": "_WarehouseOrderPickHndlgUnit"
                    },
                    "InsertRestrictions": {
                        "Insertable": false
                    }
                },
