{
    "compilerOptions": {
        "target": "ES2022",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "outDir": "gen/srv",
        "rootDir": ".",
        "types": [
            "node"
        ],
        "paths": {
            "@cds-models/*": [
                "./@cds-models/*/index.ts"
            ],
            "#cds-models/*": [
                "./@cds-models/*"
            ],
            "@sap/cds": [
                "./node_modules/@cap-js/cds-types"
            ]
        }
    },
    "include": [
        "srv/**/*.ts",
        "db/**/*.ts",
        "app/**/*.ts",
        "@cds-models/**/*.ts"
    ]
}