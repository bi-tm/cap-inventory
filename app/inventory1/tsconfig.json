{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "node",
    "strict": true,
    "strictPropertyInitialization": false,
    "skipLibCheck": true,
    "allowJs": true,
    "baseUrl": ".",
    "paths": {
      "inventory1/*": [
        "webapp/*"
      ]
    },
    "types": [
      "@sapui5/types",
      "node"
    ]
  },
  "include": [
    "webapp/**/*"
  ]
}